# Required: JWT secret (min 32 chars, base64 encoded recommended)
# Generate: openssl rand -base64 32
JWT_SECRET=

# Optional: Demo user passwords (used only in 'demo' Spring profile)
DEMO_EXEC_PASSWORD=Exec@12345
DEMO_FOUNDER_PASSWORD=Founder@12345

# Optional: CORS origins (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: Frontend API base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1